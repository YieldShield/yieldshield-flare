    "test:browser": "playwright test",
    "test:journey": "node scripts/local-journey.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.3",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.7.2",
    "vite": "8.2.2"
  }
}
